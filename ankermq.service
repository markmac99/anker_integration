[Unit]
Description=Get Anker E5000 data
After=network.target

[Service]
ExecStart=%h/src/anker-mqtt-gateway/getdata.sh
ExecStop=/usr/bin/kill -SIGINT $(/usr/bin/pidof -x %h/anker-mqtt-gateway/getdata.sh)
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# copy this file to /lib/systemd/system/ then run
# sudo systemctl daemon-reload && sudo systemctl enable geohome && sudo systemctl start geohome
